# Porta HTTP da API
PORT=3000

# String de conexão com o PostgreSQL (usada pelo Prisma)
# Formato: postgresql://<usuario>:<senha>@<host>:<porta>/<database>?schema=public
DATABASE_URL="postgresql://vehicles:vehicles@localhost:5432/vehicle_sales?schema=public"

NODE_ENV=development

# Serviço de identidade (repositório soat-vehicle-identity)
AUTH_ISSUER=http://localhost:8180/realms/vehicle-sales
AUTH_AUDIENCE=vehicle-sales-api
AUTH_JWKS_URI=http://localhost:8180/realms/vehicle-sales/protocol/openid-connect/certs
