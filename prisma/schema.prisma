// Schema Prisma - Plataforma de Revenda de Veículos
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Um veículo do estoque da revenda.
/// `status` controla o ciclo de vida: AVAILABLE -> RESERVED -> SOLD,
/// podendo voltar de RESERVED para AVAILABLE caso o pagamento seja cancelado.
model Vehicle {
  id        String   @id @default(cuid())
  brand     String
  model     String
  year      Int
  color     String
  price     Decimal  @db.Decimal(10, 2)
  status    String   @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sales     Sale[]

  @@index([status, price])
  @@map("vehicles")
}

/// Compra de um veículo por um cliente cadastrado. Nasce como PENDING_PAYMENT e é
/// efetivada (PAID) ou desfeita (CANCELLED) pelo webhook de pagamento, pelo
/// `paymentCode`. O comprador é só um identificador opaco do serviço de
/// identidade: nenhum dado pessoal é guardado aqui.
model Sale {
  id          String   @id @default(cuid())
  vehicleId   String   @map("vehicle_id")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  buyerId     String   @map("buyer_id")
  price       Decimal  @db.Decimal(10, 2)
  saleDate    DateTime @map("sale_date")
  status      String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | CANCELLED
  paymentCode String   @unique @map("payment_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([buyerId])
  @@map("sales")
}
